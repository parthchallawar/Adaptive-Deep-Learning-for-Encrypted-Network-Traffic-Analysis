# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.ipynb_checkpoints/

# Data & results (large/generated — keep raw sources out of git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/dataset-metadata.json
results/*
!results/.gitkeep

# Kaggle credentials (never commit the API token)
kaggle.json
.kaggle/
*.ckpt
*.pt
*.pth
*.h5
*.onnx

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings (machine-specific overrides)
.claude/settings.local.json

# Env / secrets
.env
.env.*
